{
  "name": "@ruta-limpia/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts && vitest run --config vitest.integration.config.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/shared/infrastructure/db/cli.ts migrate",
    "db:seed": "tsx --env-file-if-exists=../../.env src/shared/infrastructure/db/cli.ts seed",
    "vapid:generate": "tsx src/alerts/infrastructure/vapid-keys-cli.ts",
    "user:create": "tsx --env-file-if-exists=../../.env src/auth/infrastructure/user-cli.ts",
    "db:migrate:dist": "node dist/shared/infrastructure/db/cli.js migrate",
    "db:seed:dist": "node dist/shared/infrastructure/db/cli.js seed",
    "user:create:dist": "node dist/auth/infrastructure/user-cli.js",
    "vapid:generate:dist": "node dist/alerts/infrastructure/vapid-keys-cli.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "fastify": "^5.12.5",
    "kysely": "^0.29.6",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "testcontainers": "^12.2.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
