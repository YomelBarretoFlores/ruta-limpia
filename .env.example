# Copy to `.env` and adjust. `.env` is git-ignored; never commit real secrets.
# Shared by the API (`pnpm dev`) and the local infrastructure (infra/docker-compose.yml).

# --- PostgreSQL / PostGIS (infra `db` service) ---
POSTGRES_USER=ruta_limpia
POSTGRES_PASSWORD=ruta_limpia_local
POSTGRES_DB=ruta_limpia

# --- API (apps/api) ---
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://ruta_limpia:ruta_limpia_local@localhost:5432/ruta_limpia
# Shared secret Traccar sends in the X-Ingest-Token header; at least 32 characters.
# Generate one with: openssl rand -hex 32
INGEST_TOKEN=local-dev-ingest-token-change-me-0123456789

# --- Traccar (infra `traccar` service) ---
# Traccar stores its own data in a separate `traccar` database on the same PostGIS server
# (created by infra/db/init on the first start of the data volume).
# Where Traccar forwards positions. The default reaches the API running on the host via `pnpm dev`.
# When the API runs in the same compose project, use its service name, e.g. http://api:3000/...
TRACCAR_FORWARD_URL=http://host.docker.internal:3000/ingest/traccar/positions
# JVM memory limits (keep the stack within a ~2 GB VPS).
TRACCAR_JAVA_OPTS=-Xms64m -Xmx320m
