<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE properties SYSTEM 'http://java.sun.com/dtd/properties.dtd'>
<!--
  Static Traccar settings for Ruta Limpia. Documentation: https://www.traccar.org/configuration-file/

  Secrets and environment-specific values (database URL and credentials, forward URL, X-Ingest-Token
  header) are NOT stored here. Traccar does not expand ${VAR} placeholders inside this file; instead,
  with CONFIG_USE_ENVIRONMENT_VARIABLES=true it reads each key from an environment variable named after
  it (forward.url -> FORWARD_URL). infra/traccar/entrypoint.sh builds those variables from the
  environment; each compose file sets TRACCAR_FORWARD_URL for its own topology.
-->
<properties>

    <!-- Only the protocols we use: fewer open ports and less memory than the default (all protocols). -->
    <entry key='protocols.enable'>osmand,gt06</entry>
    <entry key='osmand.port'>5055</entry>
    <entry key='gt06.port'>5023</entry>

    <!-- Traccar's own database (PostgreSQL); URL and credentials come from the environment. -->
    <entry key='database.driver'>org.postgresql.Driver</entry>

    <!--
      Forward every position as JSON: POST {"position": {...}, "device": {...}} to forward.url.
      Note: position.speed is in knots. forward.url and forward.header come from the environment.
    -->
    <entry key='forward.type'>json</entry>
    <entry key='forward.retry.enable'>true</entry>

    <entry key='logger.console'>true</entry>

</properties>
